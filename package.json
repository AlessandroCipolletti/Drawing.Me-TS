{
  "name": "drawing.me-ts",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "bad": "node scripts/deploy.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "knip": "knip",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run knip",
    "prepare": "husky"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "mobile-device-detect": "^0.4.3",
    "peerjs": "^1.5.4",
    "tinycolor2": "^1.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/tinycolor2": "^1.4.6",
    "@types/uuid": "^10.0.0",
    "basic-ftp": "^6.2.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
